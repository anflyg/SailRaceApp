{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tackwise.se/contracts/race-upload-v1.schema.json",
  "title": "TackWise race upload API v1",
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "maxLength": 30, "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["compressedBytes", "expandedBytes", "samples", "events"],
      "properties": { "compressedBytes": { "const": 5242880 }, "expandedBytes": { "const": 20971520 }, "samples": { "const": 50000 }, "events": { "const": 10000 } }
    },
    "prepareRequest": {
      "type": "object", "additionalProperties": false, "required": ["rawFormatVersion", "rawSha256", "compressedBytes", "startedAt", "endedAt", "durationSeconds", "distanceMeters"],
      "properties": { "rawFormatVersion": { "const": 1 }, "rawSha256": { "$ref": "#/$defs/sha256" }, "compressedBytes": { "type": "integer", "minimum": 1, "maximum": 5242880 }, "startedAt": { "$ref": "#/$defs/timestamp" }, "endedAt": { "$ref": "#/$defs/timestamp" }, "durationSeconds": { "type": "integer", "minimum": 0 }, "distanceMeters": { "type": "number", "minimum": 0 } }
    },
    "preparedResponse": {
      "type": "object", "additionalProperties": false, "required": ["requestId", "raceId", "uploadState", "contentUrl", "expiresAt", "limits"],
      "properties": { "requestId": { "$ref": "#/$defs/requestId" }, "raceId": { "$ref": "#/$defs/uuid" }, "uploadState": { "const": "prepared" }, "contentUrl": { "type": "string", "pattern": "^/v1/races/[0-9a-f-]{36}/upload/content$" }, "expiresAt": { "$ref": "#/$defs/timestamp" }, "limits": { "$ref": "#/$defs/limits" } }
    },
    "acceptedResponse": {
      "type": "object", "additionalProperties": false, "required": ["requestId", "raceId", "uploadState", "syncState", "consumedFreeRace"],
      "properties": { "requestId": { "$ref": "#/$defs/requestId" }, "raceId": { "$ref": "#/$defs/uuid" }, "uploadState": { "const": "accepted" }, "syncState": { "const": "uploaded" }, "consumedFreeRace": { "type": "boolean" } }
    },
    "prepareResponse": { "oneOf": [{ "$ref": "#/$defs/preparedResponse" }, { "$ref": "#/$defs/acceptedResponse" }] },
    "finalizeRequest": { "type": "object", "additionalProperties": false, "required": ["rawFormatVersion", "rawSha256"], "properties": { "rawFormatVersion": { "const": 1 }, "rawSha256": { "$ref": "#/$defs/sha256" } } },
    "finalizeResponse": { "$ref": "#/$defs/acceptedResponse" }
  }
}
